{
  "name": "ubsc-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend UB Sport Center - Express 5 + Prisma 7 (API, worker cron, upload)",
  "main": "dist/src/app.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "tsc && node dist/scripts/write-contract-hash.js",
    "prestart": "npm run build",
    "start": "node dist/src/app.js",
    "worker": "node dist/src/worker.js",
    "seed": "tsx prisma/seed.ts",
    "test": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watchAll",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"{src,shared,scripts,prisma,tests,docs,ops}/**/*.{ts,js,mjs,cjs,json,md}\" \"*.{ts,js,mjs,cjs,md}\" package.json tsconfig.json --cache",
    "format:write": "prettier --write \"{src,shared,scripts,prisma,tests,docs,ops}/**/*.{ts,js,mjs,cjs,json,md}\" \"*.{ts,js,mjs,cjs,md}\" package.json tsconfig.json --cache",
    "contract:hash": "tsx scripts/print-contract-hash.ts",
    "check:orphans": "tsx scripts/check-orphans.ts",
    "storage:migrate-r2": "tsx scripts/migrate-uploads-to-r2.ts",
    "check:booking-instants": "tsx scripts/check-booking-instants.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.0.1",
    "@prisma/client": "^7.7.0",
    "aws4fetch": "1.0.20",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.13",
    "sanitize-html": "^2.18.0",
    "sharp": "0.35.4",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.12",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "prisma": "^7.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0"
  }
}
