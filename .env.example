# ===== Server =====
# Tiga proses di satu VPS: landing 3000, admin 3001, API 4020.
PORT=4020
NODE_ENV=development

# R13: timezone proses. Aturannya - UTC di database dan di kabel, Asia/Jakarta
# hanya saat render. Tanpa ini, booking jam 23:30 WIB mendarat di tanggal yang
# salah. Wajib di-set juga di ops/ecosystem.config.js (PM2 tidak mewarisi shell).
TZ=Asia/Jakarta

# Dipakai untuk menyusun URL absolut (tautan email, redirect OAuth, path upload).
API_BASE_URL=http://localhost:4020
LANDING_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Batas waktu drain saat SIGTERM: request (API) atau job (worker) yang sedang
# berjalan diberi waktu sekian milidetik untuk selesai sebelum sisa koneksi
# diputus paksa. Naikkan bila ada transaksi yang wajar berjalan lebih lama.
SHUTDOWN_TIMEOUT_MS=10000

# ===== Database =====
# MySQL lokal (Laragon), bukan Docker. Buat database kosong `ubsc_dev` dulu,
# lalu jalankan `npm run prisma:migrate`.
DATABASE_URL=mysql://root:@localhost:3306/ubsc_dev

# R5: boilerplate meng-hardcode 5. Transaksi interaktif mem-pin satu koneksi
# selama durasinya, sedangkan booking dan approve pembayaran semuanya transaksi
# interaktif - lima booking bersamaan cukup untuk memacetkan seluruh situs.
# Naikkan bertahap dan selalu bandingkan dengan max_connections MySQL.
# Worker cron TIDAK memakai nilai ini: dia punya client sendiri dengan
# connectionLimit 1 karena GET_LOCK bersifat per-koneksi (R14).
DB_CONNECTION_LIMIT=20

# Detik. Koneksi menganggur lebih lama dari ini dilepas dari pool.
DB_POOL_IDLE_TIMEOUT=60

# ===== Auth - audience customer =====
# Customer login di ubsportcenter.co.id. Secret-nya WAJIB berbeda dari staff;
# itulah yang memisahkan kedua sesi.
#
# Nama cookie-nya TIDAK diatur di sini. ubsc_c_* dan ubsc_s_* adalah kontrak
# dengan middleware kedua app Next, jadi tempatnya di kode - lihat konstanta
# COOKIES di src/services/auth-services.ts.
CUSTOMER_ACCESS_TOKEN_SECRET=change_me_customer_access_secret

# ===== Auth - audience staff =====
# Staff login di dash.ubsportcenter.co.id.
STAFF_ACCESS_TOKEN_SECRET=change_me_staff_access_secret

# Secret dasar untuk fallback turunan di src/utils/jwt.ts. Dipakai HANYA bila
# salah satu secret per-audience di atas kosong, dan hanya di development/test:
# di produksi env.ts mewajibkan keduanya terisi, jadi baris ini tidak pernah
# terpakai di sana. Boleh tetap kosong selama kedua secret di atas sudah diisi.
ACCESS_TOKEN_SECRET=

# ===== Auth - setelan bersama =====
ACCESS_TOKEN_EXPIRES=15m
# Detik. 2592000 = 30 hari.
REFRESH_TOKEN_EXPIRES_SECONDS=2592000
# Batas sesi aktif per user (multi-device) sebelum sesi terlama dicabut.
MAX_SESSIONS=5
# Jumlah gagal login sebelum akun dikunci.
MAX_FAILED_LOGINS=5

# Bypass permission untuk panggilan service-to-service. Kosong berarti tidak ada
# bypass sama sekali, dan itu default yang benar - call site sudah menolak nilai
# kosong. Isi hanya bila ada proses internal yang memang perlu memintas RBAC.
INTERNAL_SERVICE_KEY=

# R4: SENGAJA DIKOSONGKAN, termasuk di produksi.
# Nilai kosong menghasilkan cookie host-only, dan justru itulah yang memisahkan
# sesi staff dari sesi customer. Mengisi `.ubsportcenter.co.id` akan membagikan
# seluruh cookie ke kedua subdomain - sesi staff bocor ke situs publik.
COOKIE_DOMAIN=

# ===== Mail =====
# MAIL_TRANSPORT=log  -> email ditulis sebagai berkas .eml ke MAIL_PREVIEW_DIR.
#                        Dipakai di development; tidak butuh Mailpit maupun Docker.
# MAIL_TRANSPORT=smtp -> kirim sungguhan lewat setelan di bawah. Dipakai di produksi.
MAIL_TRANSPORT=log
MAIL_PREVIEW_DIR=storage/mail-preview

MAIL_HOST=smtp.hostinger.com

# Port 465 (SMTPS implisit), bukan 587. Alasannya diwarisi dari .env Laravel:
# di 587 handshake STARTTLS tidak dibatasi socket timeout, sehingga handshake
# yang macet menggantung request sampai prosesnya dimatikan.
MAIL_PORT=465
MAIL_SECURE=true

MAIL_USER=no-reply@ubsportcenter.co.id
# Isi hanya di .env lokal/server. Jangan pernah masuk repo.
MAIL_PASSWORD=
# Alamat pengirim. Bila dikosongkan, mailer memakai MAIL_USER sebagai pengirim.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="UB Sport Center"

# R8: batas keras agar SMTP yang menggantung tidak menahan proses. Pengiriman
# selalu di luar $transaction - timeout 10 detik di dalam transaksi akan mem-pin
# koneksi sekaligus menahan row lock.
MAIL_TIMEOUT_MS=10000

# ===== Upload =====
# uploads/        -> disajikan express.static sebagai /uploads, PUBLIK.
# storage/private/ -> bukti bayar & dokumen identitas, TIDAK PERNAH di-mount.
UPLOAD_DIR=uploads
PRIVATE_STORAGE_DIR=storage/private

# ===== Google OAuth =====
# Kosong berarti tombol "Masuk dengan Google" dinonaktifkan. Redirect URI harus
# didaftarkan persis sama di Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4020/api/auth/google/callback

# ===== Misc =====
# Folder rotasi winston (winston-daily-rotate-file).
LOG_DIR=logs

# Password untuk akun yang dibuat `npm run seed`. Development saja.
SEED_PASSWORD=password123
